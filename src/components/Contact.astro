---
import { content, site, type Lang } from "@/i18n/content";
import { icons } from "@/i18n/icons";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].contact;
const field =
  "px-4 py-2 bg-[var(--card)] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]";
---

<section id="contact" class="w-full py-12 border-t border-[var(--line)]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg mb-2 shiny-sec">{t.eyebrow}</h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">{t.title}</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-[var(--white-icon)] space-y-4">
        <p>{t.intro}</p>
        <p>
          <span>{t.location} : </span>
          <span class="text-[var(--white)]">{t.locationValue}</span>
        </p>
        <ul class="space-y-2">
          <li>
            <a class="inline-flex items-center gap-2 hover:text-[var(--white)] transition-colors" href={`mailto:${site.email}`}>
              <span set:html={icons.mail("size-5")} />{site.email}
            </a>
          </li>
          <li>
            <a class="inline-flex items-center gap-2 hover:text-[var(--white)] transition-colors" href={site.linkedin} target="_blank" rel="noopener noreferrer">
              <span set:html={icons.linkedin("size-5")} />LinkedIn
            </a>
          </li>
          <li>
            <a class="inline-flex items-center gap-2 hover:text-[var(--white)] transition-colors" href={site.github} target="_blank" rel="noopener noreferrer">
              <span set:html={icons.github("size-5")} />GitHub
            </a>
          </li>
        </ul>
      </div>

      <div>
        {
          site.formspreeId ? (
            <>
              <form
                id="contact-form"
                action={`https://formspree.io/f/${site.formspreeId}`}
                method="POST"
                class="flex flex-col gap-4"
                data-sending={t.form.sending}
                data-send={t.form.send}
                data-error={t.form.error}
              >
                <input type="text" name="from_name" placeholder={t.form.name} aria-label={t.form.name} required class={field} />
                <input type="email" name="reply_to" placeholder={t.form.email} aria-label={t.form.email} required class={field} />
                <textarea name="message" placeholder={t.form.message} aria-label={t.form.message} rows="6" required class={`${field} resize-none`} />
                <button type="submit" class="icon-btn px-4 py-2 !text-[var(--white)] opacity-70 hover:opacity-100">
                  {t.form.send}
                </button>
              </form>
              <p id="form-message" class="hidden mt-4 text-[var(--white)] text-lg" role="status">
                {t.form.success}
              </p>
            </>
          ) : (
            <a href={`mailto:${site.email}`} class="icon-btn inline-flex items-center gap-2 px-5 py-3">
              <span set:html={icons.mail("size-5")} />
              {t.mailCta}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const message = document.getElementById("form-message");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector("button");
    if (button) {
      button.disabled = true;
      button.textContent = form.dataset.sending ?? "";
    }
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      form.style.display = "none";
      message?.classList.remove("hidden");
    } catch (error) {
      console.error(error);
      alert(form.dataset.error);
      if (button) {
        button.disabled = false;
        button.textContent = form.dataset.send ?? "";
      }
    }
  });
</script>
