---
import { content, site, type Lang } from "@/i18n/content";
import { icons } from "@/i18n/icons";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].projects;
const ui = content[lang].ui;
---

<section id="projects" class="py-12 border-t border-[var(--line)] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg mb-2 shiny-sec">{t.eyebrow}</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">{t.title}</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        t.items.map((project) => (
          <article class="flex flex-col rounded-2xl border border-[var(--white-icon-tr)] bg-[var(--card)] p-6 transition-colors hover:border-[var(--sec)]">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h4 class="text-2xl font-semibold">{project.title}</h4>
                <span class="text-sm text-[var(--white-icon)]">{project.status}</span>
              </div>
              <div class="flex gap-2">
                <a
                  href={project.code}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${ui.code} – ${project.title}`}
                  title={ui.code}
                  class="icon-btn size-11 flex items-center justify-center"
                  set:html={icons.github("size-6")}
                />
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${ui.demo} – ${project.title}`}
                    title={ui.demo}
                    class="icon-btn size-11 flex items-center justify-center"
                    set:html={icons.external("size-6")}
                  />
                )}
              </div>
            </div>
            <p class="mt-4 text-[var(--white-icon)] leading-relaxed flex-grow">{project.description}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {project.tags.map((tag) => <li class="chip">{tag}</li>)}
            </ul>
          </article>
        ))
      }
    </div>

    <a
      target="_blank"
      rel="noopener noreferrer"
      href={`${site.github}?tab=repositories`}
      class="icon-btn !rounded-full w-full flex items-center justify-center gap-2 mt-9 p-3 hover:scale-[1.02]"
    >
      <span class="md:text-lg text-md">{t.more}</span>
      <span set:html={icons.github("size-6")} />
    </a>
  </div>
</section>
